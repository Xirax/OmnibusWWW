---
import logo from "../../images/logo1.png";
import iconFB from "../../images/socials/FB.png";
import iconInsta from "../../images/socials/Insta.png";
import iconTiktok from "../../images/socials/tiktok.png";
import iconYoutube from "../../images/socials/youtube.png";
import iconLinkedIn from "../../images/socials/linkedIn.png";

const socialLinks = [
  { href: "https://www.facebook.com/profile.php?id=61551022192369",        label: "Facebook",  icon: iconFB },
  { href: "https://www.instagram.com/omnibusmediastudio/",                 label: "Instagram", icon: iconInsta },
  { href: "https://www.tiktok.com/@omnibusmediastudio",                    label: "TikTok",    icon: iconTiktok },
  { href: "https://www.youtube.com/@OmnibusMediaStudio",                   label: "YouTube",   icon: iconYoutube },
  { href: "https://www.linkedin.com/in/omnibus-media-studio-a618253b8/",   label: "LinkedIn",  icon: iconLinkedIn },
];
---

<footer id="kontakt" class="bg-primary-light flex items-center px-6 sm:px-12 lg:px-[150px] py-10 lg:py-0 lg:min-h-[250px]">
  <div class="flex flex-col lg:flex-row items-center w-full gap-10 lg:gap-[150px]">

    <!-- Contact subsection -->
    <div class="flex flex-col gap-2 items-center lg:items-start">
      <h2 class="text-fhd font-ironclad text-white tracking-[0.2em] uppercase mb-1">Kontakt</h2>
      <a href="tel:+48515149256" class="text-fsmall text-white/70 hover:text-white transition-colors duration-300 lg:pointer-events-none lg:cursor-default">515 149 256 - Franciszek | Video </a>
      <a href="tel:+48882308213" class="text-fsmall text-white/70 hover:text-white transition-colors duration-300 lg:pointer-events-none lg:cursor-default">882 308 213 - Dominik | Foto </a>

      <p class="text-fsmall text-white/70">omnibusmediastudio@gmail.com</p>
      <div class="flex items-center gap-3 mt-2">
        {socialLinks.map(({ href, label, icon }) => (
          <a href={href} aria-label={label} target="_blank" rel="noopener noreferrer" class="opacity-50 hover:opacity-100 transition-opacity duration-300">
            <img src={icon.src} alt={label} class="w-[24px] h-[24px] object-contain" />
          </a>
        ))}
      </div>
    </div>

    <!-- Button -->
    <a
      href="https://mail.google.com/mail/?view=cm&to=omnibusmediastudio@gmail.com"
      target="_blank"
      rel="noopener noreferrer"
      class="bg-accent text-white text-fsmall tracking-[0.2em] uppercase px-8 py-4 hover:bg-accent-light transition-colors duration-300 shrink-0 rounded-[2px]"
    >
      Napisz do nas
    </a>

    <!-- Spacer -->
    <div class="hidden lg:block flex-1"></div>

    <!-- Logo -->
    <img src={logo.src} alt="Omnibus Media Studio" class="h-24 w-auto object-contain" />

  </div>
</footer>