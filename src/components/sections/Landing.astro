---
import { Image } from "astro:assets";
import landingImg from "../../images/landing_page.jpg";
---

<section class="relative w-full h-screen overflow-hidden">
  <!-- Background image -->
  <Image
    src={landingImg}
    alt="Omnibus Media Studio - sesja fotograficzna"
    class="absolute inset-0 w-full h-full object-cover object-center"
    loading="eager"
    fetchpriority="high"
  />

  <!-- Dark overlay with subtle gradient -->
  <div
    class="absolute inset-0 bg-gradient-to-b from-primary/85 via-primary/65 to-primary/90"
  >
  </div>

  <!-- Centered text -->
  <div
    class="relative z-10 flex flex-col items-center justify-center h-full px-6 text-center"
  >
    <div class="overflow-hidden">
      <p
        class="font-ironclad text-fmd tracking-[0.35em] uppercase text-accent mb-6 animate-fade-in-up hero-tagline"
      >
        Fotografia &amp; Film
      </p>
    </div>
    <div class="overflow-hidden">
      <h1
        class=" text-4xl md:text-6xl lg:text-7xl text-white leading-tight max-w-4xl animate-fade-in-up hero-heading"
      >
        Obrazy, które mówią <br />
        więcej niż słowa
      </h1>
    </div>
    <div class="overflow-hidden mt-4">
      <p
        class="font-ironclad text-fmd tracking-[0.2em] uppercase text-white/50 animate-fade-in-up hero-subtitle"
      >
        Omnibus Media Studio
      </p>
    </div>
  </div>

  <!-- Scroll arrow -->
  <button
    id="scroll-down-btn"
    aria-label="Przewiń do następnej sekcji"
    class="absolute bottom-10 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-2 animate-bounce-slow cursor-pointer bg-transparent border-none p-0"
  >
    <span class="text-[10px] tracking-[0.3em] uppercase text-white/40 pl-[0.3em]">
      Przewiń
    </span>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="w-5 h-5 text-accent"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      viewBox="0 0 24 24"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"
      ></path>
    </svg>
  </button>

  <script>
    document.getElementById("scroll-down-btn")?.addEventListener("click", () => {
      document.getElementById("oferta")?.scrollIntoView({ behavior: "smooth" });
    });
  </script>
</section>