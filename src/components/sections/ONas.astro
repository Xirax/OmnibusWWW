---
import omnibusImg from '../../images/onas/omnibus.png';
import franekImg from '../../images/onas/franek.JPG';
import dominikImg from '../../images/onas/dominik.JPG';

const omnibus = {
  title: 'Omnibus',
  description: 'Omnibus Media Studio powstało w 2023 roku. Na czele stoi dwóch młodych, ambitnych przyjaciół, którzy trzymają się ze sobą od 15 lat i profesjonalnie realizują pasje do obrazu i kreatywnej pracy. Razem z naszym młodym, energicznym zespołem fotografów, montażystów i operatorów tworzymy przestrzeń, w której każdy projekt zyskuje profesjonalne wsparcie i świeże spojrzenie. Od początku stawiamy na rozwój, otwartość i indywidualne podejście do każdego zadania. Nie boimy się wyzwań – wręcz przeciwnie, to one napędzają nas do działania. Dbamy o spójność oraz efekt końcowy realizacji, które naprawdę wyróżniają naszych klientów.',
};

const franek = {
  title: 'Franciszek',
  description: 'Franciszek Ochoński to 21-letni operator kamery i montażysta wideo z ponad 4,5-letnim doświadczeniem w branży foto i wideo. W swojej pracy stawia na precyzję, dbałość o detale i wysoką jakość realizacji na każdym etapie produkcji. Łączy techniczne umiejętności z wyczuciem estetyki, tworząc materiały dynamiczne i dostosowane do panujących trendów. Profesjonalne podejście, otwartość i charyzmatyczna osobowość sprawiają, że współpraca przebiega sprawnie i w dobrej atmosferze.',
};

const dominik = {
  title: 'Dominik',
  description: 'Dominik Zięba to 21-letni fotograf i grafik z ponad 6-letnim doświadczeniem w branży foto-wideo i certyfikatem technika PGF.04. Specjalizuje się w tworzeniu projektów graficznych i fotograficznych, dbając o każdy detal i estetykę materiałów. Jego kreatywność, zaangażowanie i przyjazne podejście sprawiają, że współpraca z nim jest nie tylko efektywna, ale i inspirująca.',
};
---

<section id="o-nas" class="py-24 px-4 min-[1100px]:px-[45px]">

  <!-- Section header -->
  <div class="flex items-center gap-4 mb-20">
    <div class="h-px bg-white/20 w-12 shrink-0"></div>
    <span class="font-ironclad text-md tracking-[0.3em] uppercase text-white whitespace-nowrap pl-2">O nas</span>
    <div class="h-px bg-white/20 flex-1"></div>
  </div>

  <div class="flex flex-col gap-28">

    <!-- Omnibus — large two-column like Oferta -->
    <div class="flex flex-col min-[1100px]:flex-row items-center gap-6 min-[1100px]:gap-12">

      <div class="flex-1 flex flex-col text-center w-full">
        <h3 class="text-4xl font-light text-white mb-3">{omnibus.title}</h3>
        <div class="h-px bg-accent mb-8 mx-auto" style="width: 250px"></div>
        <p class="text-fsmall text-white/60 leading-relaxed max-w-[650px] mx-auto text-justify">{omnibus.description}</p>
      </div>

      <div class="flex-1 flex justify-center onas-image w-full" data-direction="right">
        <img
          src={omnibusImg.src}
          alt={omnibus.title}
          class="w-full max-w-[600px]"
        />
      </div>

    </div>

    <!-- Franciszek & Dominik — single 4-column row -->
    <div class="grid grid-cols-1 min-[800px]:grid-cols-2 min-[1500px]:grid-cols-4 items-center gap-6 min-[1500px]:gap-8">

      <!-- Franciszek text -->
      <div class="flex-1 flex flex-col text-center w-full">
        <h3 class="text-4xl font-light text-white mb-3">{franek.title}</h3>
        <div class="h-px bg-accent mb-8 mx-auto" style="width: 250px"></div>
        <p class="text-fsmall text-white/60 leading-relaxed mx-auto text-justify">{franek.description}</p>
      </div>

      <!-- Franciszek image -->
      <div class="flex-1 flex justify-center onas-image w-full" data-direction="left">
        <img
          src={franekImg.src}
          alt={franek.title}
          class="w-full"
        />
      </div>

      <!-- Dominik image -->
      <div class="flex-1 flex justify-center onas-image w-full order-4 min-[800px]:order-3" data-direction="right">
        <img
          src={dominikImg.src}
          alt={dominik.title}
          class="w-full"
        />
      </div>

      <!-- Dominik text -->
      <div class="flex-1 flex flex-col text-center w-full order-3 min-[800px]:order-4">
        <h3 class="text-4xl font-light text-white mb-3">{dominik.title}</h3>
        <div class="h-px bg-accent mb-8 mx-auto" style="width: 250px"></div>
        <p class="text-fsmall text-white/60 leading-relaxed mx-auto text-justify">{dominik.description}</p>
      </div>

    </div>

  </div>

</section>

<style>
  .onas-image {
    opacity: 0;
    transition: opacity 0.75s ease, transform 0.75s ease;
  }
  .onas-image[data-direction="right"] {
    transform: translateX(70px);
  }
  .onas-image[data-direction="left"] {
    transform: translateX(-70px);
  }
  .onas-image.visible {
    opacity: 1;
    transform: translateX(0);
  }
</style>

<script>
  const images = document.querySelectorAll<HTMLElement>('.onas-image');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.25 }
  );
  images.forEach((el) => observer.observe(el));
</script>
