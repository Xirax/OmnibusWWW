---
const videoModules = import.meta.glob('/src/images/portfolio/videos/*.{gif,GIF}', { eager: true });
const imageModules = import.meta.glob('/src/images/portfolio/images/*.{jpg,JPG,jpeg,JPEG,png,PNG,webp,WEBP}', { eager: true });

const videos = Object.entries(videoModules).map(([path, mod]: [string, any]) => ({
  src: (mod as any).default?.src ?? (mod as any).default,
  id: path.split('/').pop()?.replace(/\.[^.]+$/, '') ?? '',
}));

const images = Object.entries(imageModules).map(([path, mod]: [string, any]) => ({
  src: (mod as any).default?.src ?? (mod as any).default,
  id: path.split('/').pop()?.replace(/\.[^.]+$/, '') ?? '',
}));
---

<section id="portfolio" class="py-24">

  <!-- Section header -->
  <div class="flex items-center gap-4 mb-16 px-3">
    <div class="h-px bg-white/20 w-12 shrink-0"></div>
    <span class="font-ironclad text-fmd tracking-[0.3em] uppercase text-white whitespace-nowrap pl-2">Portfolio</span>
    <div class="h-px bg-white/20 flex-1"></div>
  </div>

  <!-- Two full-width columns -->
  <div class="grid grid-cols-1 md:grid-cols-2 w-full">

    <!-- Left column: looping videos (gifs) -->
    <a
      id="portfolio-video"
      href="/gallery?type=video"
      class="relative group block overflow-hidden h-[50vh] md:h-[75vh] bg-primary-light"
    >
      <img
        id="video-current"
        src=""
        alt=""
        class="absolute inset-0 w-full h-full object-cover transition-opacity duration-500"
      />
      <div class="absolute inset-0 flex items-center justify-center bg-black/0 group-hover:bg-black/50 transition-all duration-300">
        <span class="font-ironclad text-fsmall tracking-[0.3em] uppercase text-white opacity-0 group-hover:opacity-100 transition-opacity duration-300">
          Zobacz więcej video...
        </span>
      </div>
    </a>

    <!-- Right column: looping images -->
    <a
      id="portfolio-image"
      href="/gallery?type=foto"
      class="relative group block overflow-hidden h-[50vh] md:h-[75vh] bg-primary-light"
    >
      <img
        id="image-current"
        src=""
        alt=""
        class="absolute inset-0 w-full h-full object-cover transition-opacity duration-500"
      />
      <div class="absolute inset-0 flex items-center justify-center bg-black/0 group-hover:bg-black/50 transition-all duration-300">
        <span class="font-ironclad text-fsmall tracking-[0.3em] uppercase text-white opacity-0 group-hover:opacity-100 transition-opacity duration-300">
          Zobacz więcej foto...
        </span>
      </div>
    </a>

  </div>

</section>

<script define:vars={{ videos, images }}>
  const videoEl = document.getElementById('video-current');
  const imageEl = document.getElementById('image-current');

  let vi = 0;
  let ii = 0;

  const SLIDE_MS = 4000;
  const FADE_MS = 500;

  function swap(el, list, index) {
    if (!el || list.length === 0) return;
    const next = list[index];
    // Fade out, swap source, fade back in
    el.style.opacity = '0';
    const onFaded = () => {
      el.src = next.src;
      el.alt = next.id;
      requestAnimationFrame(() => { el.style.opacity = '1'; });
    };
    if (el.src) {
      window.setTimeout(onFaded, FADE_MS);
    } else {
      onFaded();
    }
  }

  // Initial render (no fade)
  if (videos.length) { videoEl.src = videos[0].src; videoEl.alt = videos[0].id; videoEl.style.opacity = '1'; }
  if (images.length) { imageEl.src = images[0].src; imageEl.alt = images[0].id; imageEl.style.opacity = '1'; }

  // Single synced loop advancing both columns one by one
  if (videos.length > 1 || images.length > 1) {
    window.setInterval(() => {
      vi = (vi + 1) % videos.length;
      ii = (ii + 1) % images.length;
      swap(videoEl, videos, vi);
      swap(imageEl, images, ii);
    }, SLIDE_MS);
  }
</script>