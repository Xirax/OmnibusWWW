---
// Static poster that opens the video in <VideoOverlay />. The real player is
// only created on click, so the gallery doesn't load one iframe per video.
interface Props {
  embed: string;
  poster?: string | null;
  title?: string;
  orientation?: "vertical" | "horizontal";
}

const {
  embed,
  poster = null,
  title = "",
  orientation = "horizontal",
} = Astro.props;
---

<button
  type="button"
  class:list={[
    "group relative block w-full overflow-hidden bg-primary-light cursor-pointer",
    orientation === "vertical" ? "aspect-[9/16]" : "aspect-video",
  ]}
  data-video-embed={embed}
  data-video-orientation={orientation}
  data-video-title={title}
  aria-label={title ? `Odtwórz wideo: ${title}` : "Odtwórz wideo"}
>
  {
    poster && (
      <img
        src={poster}
        alt=""
        loading="lazy"
        decoding="async"
        referrerpolicy="no-referrer"
        onerror="this.remove()"
        class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
    )
  }

  <span
    class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent"
  ></span>

  <span
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 flex items-center justify-center w-14 h-14 rounded-full border border-accent bg-black/40 text-accent transition-colors duration-300 group-hover:bg-accent group-hover:text-white group-focus-visible:bg-accent group-focus-visible:text-white"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="w-6 h-6 translate-x-0.5"
      fill="currentColor"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path d="M8 5v14l11-7z"></path>
    </svg>
  </span>

  {
    title && (
      <span class="absolute bottom-0 inset-x-0 p-3 text-left font-ironclad text-fsmall tracking-[0.15em] uppercase text-white line-clamp-2">
        {title}
      </span>
    )
  }
</button>
