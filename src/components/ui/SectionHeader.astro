---
interface Props {
  title: string;
  class?: string;
}

const { title, class: className } = Astro.props;
---

<div class:list={["flex items-center gap-4 mb-8", className]}>
  <div class="h-px bg-white/20 w-12 shrink-0"></div>
  <h2
    class="font-ironclad text-fmd tracking-[0.3em] uppercase text-white whitespace-nowrap pl-2"
  >
    {title}
  </h2>
  <div class="h-px bg-white/20 flex-1"></div>
</div>
