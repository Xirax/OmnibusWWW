---
import { Image } from 'astro:assets';
import fallbackAvatar from '../../assets/opinie/avatar.png';

const descFiles = import.meta.glob('../../assets/opinie/*/desc.txt', { query: '?raw', import: 'default', eager: true });
const aliasFiles = import.meta.glob('../../assets/opinie/*/alias.txt', { query: '?raw', import: 'default', eager: true });
const avatarFiles = import.meta.glob('../../assets/opinie/*/avatar.{png,jpg,jpeg,webp}', { import: 'default', eager: true });

// Folder name is the second-to-last path segment (.../<folder>/file.ext)
const folderOf = (path) => path.split('/').slice(-2, -1)[0];

const byFolder = new Map();
const ensure = (key) => {
  if (!byFolder.has(key)) byFolder.set(key, {});
  return byFolder.get(key);
};

for (const [path, content] of Object.entries(descFiles)) ensure(folderOf(path)).desc = String(content).trim();
for (const [path, content] of Object.entries(aliasFiles)) ensure(folderOf(path)).alias = String(content).trim();
for (const [path, img] of Object.entries(avatarFiles)) ensure(folderOf(path)).avatar = img;

const opinions = [...byFolder.entries()]
  .filter(([, o]) => o.desc && o.alias) // desc.txt + alias.txt are required
  .map(([folder, o]) => ({
    folder,
    desc: o.desc,
    alias: o.alias,
    avatar: o.avatar ?? fallbackAvatar,
  }))
  .sort((a, b) => a.folder.localeCompare(b.folder));
---

<div
  id="opinie-modal"
  class="opinie-modal bg-primary text-white rounded-[6px] border border-white/10 p-3"
  role="dialog"
  aria-modal="true"
  aria-label="Opinie"
  aria-hidden="true"
>
  <!-- Header: review button (left) + close (right) -->
  <div class="flex items-center justify-between gap-3 shrink-0 mb-3">
    <a
      href="https://g.page/r/CSf9gvLX_AMDEAE/review"
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-2 bg-accent text-white text-fsmall tracking-[0.2em] uppercase px-4 py-2 hover:bg-accent-light transition-colors duration-300 shrink-0 rounded-[2px]"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
      </svg>
      Wystaw nam opinię
    </a>

    <button
      type="button"
      class="opinie-modal__close flex items-center justify-center w-8 h-8 shrink-0 rounded-full text-white/70 hover:text-white hover:bg-white/10 transition-colors duration-200"
      aria-label="Zamknij"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18"/>
      </svg>
    </button>
  </div>

  <!-- Scrollable opinions list -->
  <div class="opinie-modal__list">
    {opinions.map((o) => (
      <article class="opinie-item bg-primary-light rounded-[2px]">
        {o.avatar && (
          <Image
            src={o.avatar}
            alt={o.alias}
            width={56}
            height={56}
            class="opinie-item__avatar"
          />
        )}
        <p class="opinie-item__alias text-accent tracking-[0.1em]">{o.alias}</p>
        <p class="opinie-item__desc text-white/85">{o.desc}</p>
      </article>
    ))}
  </div>
</div>

<style>
  .opinie-modal {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    width: 500px;
    height: 650px;
    max-width: calc(100vw - 2rem);
    max-height: calc(100vh - 2rem);
    display: flex;
    flex-direction: column;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.35);
    z-index: 1000;

    /* Closed: collapsed into the bottom-right corner */
    transform-origin: bottom right;
    transform: scale(0);
    opacity: 0;
    visibility: hidden;
    transition:
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.25s ease,
      visibility 0s linear 0.35s;
  }

  .opinie-modal.is-open {
    transform: scale(1);
    opacity: 1;
    visibility: visible;
    transition:
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.25s ease,
      visibility 0s;
  }

  /* Scroll area — left/top padding leaves room for the avatars that
     overflow the top-left corner of each item, so they aren't clipped. */
  .opinie-modal__list {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 45px;
    padding: 28px 8px 8px 28px;
  }

  .opinie-item {
    position: relative;
    width: 100%;
    height: auto;
    padding: 12px;
  }

  /* Avatar circle whose center sits exactly on the item's top-left corner */
  .opinie-item__avatar {
    position: absolute;
    top: 0;
    left: 0;
    width: 35px;
    height: 35px;
    border-radius: 9999px;
    object-fit: cover;
    transform: translate(-50%, -50%);
  }

  /* Alias sits top-left but indented so it clears the avatar */
  .opinie-item__alias {
    margin: 0 0 2px 32px;
    font-size: 15px;
    line-height: 1.2;
  }

  .opinie-item__desc {
    margin: 0;
    font-size: 14px;
    line-height: 1.45;
    white-space: pre-line;
  }
</style>

<script src="./opiniemodal.js"></script>
