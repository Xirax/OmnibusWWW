---
import Section from "../../components/ui/Section.astro";
import VideoCard from "../../components/ui/VideoCard.astro";
import VideoOverlay from "../../components/ui/VideoOverlay/VideoOverlay.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header/Header.astro";

import "../../styles/index.css";
import videos from "./videos.json";
import shorts from "./shorts.json";
import { toVideos } from "./_utils.js";

// Order follows the nav anchors in this folder's header.json.
// Shorts are vertical (9:16), so they get a narrower card and more per row.
const sections = [
  {
    id: "shorts",
    title: "Shorts",
    videos: await toVideos(shorts),
    orientation: "vertical",
    grid: "grid-cols-2 sm:grid-cols-3 lg:grid-cols-4",
  },
  {
    id: "longs",
    title: "Długi format",
    videos: await toVideos(videos),
    orientation: "horizontal",
    grid: "grid-cols-1 sm:grid-cols-2 lg:grid-cols-3",
  },
] as const;
---

<BaseLayout title="Wideo — Omnibus Media Studio">
  <div class="overflow-x-hidden">
    <!-- ========== HEADER ========== -->
    <Header />

    <main class="pt-[70px]">
      <!-- ========== PAGE TITLE ========== -->
      <div class="text-center pt-16 pb-4 px-6">
        <p
          class="font-ironclad text-fsmall tracking-[0.3em] uppercase text-accent mb-4"
        >
          Omnibus Media Studio
        </p>
        <h1 class="font-display text-4xl md:text-6xl text-white">
          Galeria wideo
        </h1>
      </div>

      <!-- ========== VIDEO SECTIONS ========== -->
      {
        sections.map((section) => (
          <Section
            id={section.id}
            title={section.title}
            class="scroll-mt-[70px]"
          >
            {section.videos.length > 0 ? (
              <div class:list={["grid gap-4", section.grid]}>
                {section.videos.map((video) => (
                  <VideoCard {...video} orientation={section.orientation} />
                ))}
              </div>
            ) : (
              <p class="font-ironclad text-fsmall tracking-[0.2em] uppercase text-white/40 px-3">
                Wkrótce...
              </p>
            )}
          </Section>
        ))
      }
    </main>
  </div>

  <VideoOverlay />
</BaseLayout>
